# ============================================================
# TRINETRA backend environment
# Copy to .env and fill in. NEVER commit .env
# ============================================================

ENV=dev
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase Postgres -------------------------------------
# App uses the POOLER string (port 6543, transaction mode)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Alembic uses the DIRECT string (port 5432) - pooler breaks DDL
DATABASE_DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Supabase project --------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
JWT_ISSUER=https://xxxx.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
EVIDENCE_BUCKET=evidence
BACKUP_BUCKET=evidence-backups

# --- Neo4j AuraDB Free -------------------------------------
# NOTE: free instances auto-pause after 72h of inactivity.
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_ENABLED=true

# --- Redis / Celery ----------------------------------------
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379
CELERY_ENABLED=true

# --- AI provider (gemini | groq | ollama) ------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Encryption --------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Optional heavy features (off by default) --------------
WHISPER_ENABLED=false
WHISPER_MODEL_SIZE=tiny
CLAMAV_ENABLED=false
